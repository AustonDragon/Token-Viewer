{
  "name": "token-viewer",
  "displayName": "Token Viewer",
  "description": "在 VSCode 状态栏实时显示小米 MiMo 平台的剩余 Token 数量",
  "version": "1.2.0",
  "publisher": "bynlk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bynlk/Token-Viewer.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenViewer.refresh",
        "title": "Token Viewer: 刷新 Token 数量"
      },
      {
        "command": "tokenViewer.configure",
        "title": "Token Viewer: 配置 Cookie"
      },
      {
        "command": "tokenViewer.openSettings",
        "title": "Token Viewer: 打开设置面板"
      },
      {
        "command": "tokenViewer.menu",
        "title": "Token Viewer: 菜单"
      }
    ],
    "configuration": {
      "title": "Token Viewer",
      "properties": {
        "tokenViewer.headers": {
          "type": "object",
          "default": {},
          "description": "请求头（JSON 对象），只需填写 Cookie"
        },
        "tokenViewer.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 10,
          "description": "自动刷新间隔（秒），最小值为 10 秒"
        },
        "tokenViewer.alertThreshold": {
          "type": "number",
          "default": 10000000,
          "minimum": 0,
          "description": "告警阈值，当剩余 Token 小于等于此值时显示警告"
        },
        "tokenViewer.enableUsageNotification": {
          "type": "boolean",
          "default": true,
          "description": "启用用量报告通知，定期弹出通知显示 Token 消耗情况"
        },
        "tokenViewer.notificationInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "用量报告通知的间隔（分钟），最小值为 5 分钟"
        },
        "tokenViewer.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏显示 Token 信息"
        },
        "tokenViewer.xiaomiPlanType": {
          "type": "string",
          "default": "cn",
          "enum": ["cn", "sg", "balance"],
          "enumDescriptions": [
            "Token Plan (CN) - 国内区域",
            "Token Plan (SG) - 新加坡区域",
            "Balance - 余额直扣（即将支持）"
          ],
          "description": "小米 MiMo 计费模式"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0"
  }
}
